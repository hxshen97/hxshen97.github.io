{
  "name": "personal-homepage",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "test": "node --experimental-strip-types --test tests/unit/*.test.mjs",
    "test:integrity": "node scripts/check-integrity.mjs",
    "test:blog": "node scripts/test-blog.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run check && npm test && npm run build && npm run test:integrity && npm run test:blog && npm run test:e2e"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.8",
    "astro": "^5.18.1",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
    "js-yaml": "^4.1.1"
  }
}
