---
// src/pages/zh/cv/index.astro
import SidebarLayout from '../../../layouts/SidebarLayout.astro';
import { t, type Lang } from '../../../i18n/ui';
const lang: Lang = 'zh';
---
<SidebarLayout title={t(lang, 'cv.title')} description="HxS 的个人简历。" lang={lang}>
  <div class="cv-header">
    <h1>{t(lang, 'cv.title')}</h1>
  </div>

  <section class="cv-section">
    <h2>{t(lang, 'cv.education')}</h2>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <strong>复旦大学 · 计算数学 博士</strong>
        <span class="cv-date">2019.09 – 2024.07</span>
      </div>
      <div class="cv-entry-sub">上海数学中心</div>
      <p>研究领域：计算化学中的数值算法，EDA算法</p>
    </div>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <strong>复旦大学 · 信息与计算科学 本科</strong>
        <span class="cv-date">2015.09 – 2019.07</span>
      </div>
      <div class="cv-entry-sub">数学科学学院</div>
    </div>
  </section>

  <section class="cv-section">
    <h2>{t(lang, 'cv.experience')}</h2>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <strong>华为海思 · 研发工程师</strong>
        <span class="cv-date">2024.07 – 至今</span>
      </div>
      <div class="cv-entry-sub">芯片开发平台部</div>
      <ul class="cv-list">
        <li>负责物理设计领域EDA仿真算法研发工作，业务主要涉及timing和power方向。</li>
        <li>技术栈主要涵盖C++和Tcl，熟练使用STL，能够独立完成模块级开发任务，编写Tcl自动化脚本。</li>
        <li>项目一：参与crosstalk模块算法研发，针对互联线串扰噪声及延迟进行建模，负责该模块原型验证和工程落地，支撑时序分析精度提升。基于spice deck工具编写自动化时序精度验证脚本。</li>
        <li>项目二：参与Glitch Power优化工具开发，负责数字波形仿真模块与核心ECO优化策略开发，构建波形+时序+ECO的解决方案。在真实用例中获得功耗收益。</li>
      </ul>
    </div>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <strong>鸿芯微纳 · 研发实习生</strong>
        <span class="cv-date">2023.06 – 2023.08</span>
      </div>
      <ul class="cv-list">
        <li>开发STA工具时序检查模块后端（C++），实现多时钟域下的约束传播与违例检测功能。</li>
      </ul>
    </div>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <strong>华为海思 · 算法研发实习生</strong>
        <span class="cv-date">2023.02 – 2023.05</span>
      </div>
      <ul class="cv-list">
        <li>构建先进工艺节点下时序计算的数学模型，主要负责先进工艺片上误差的算法设计，交付产品级实现。</li>
      </ul>
    </div>
  </section>

  <section class="cv-section">
    <h2>{t(lang, 'cv.awards')}</h2>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <span>第一届粤港澳大湾区（黄埔）国际算法算例大赛"近似低秩矩阵的奇异值分解与求逆"赛题 —— 三等奖</span>
        <span class="cv-date">2022.11</span>
      </div>
    </div>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <span>第二届先导杯计算应用大奖赛"量子计算"赛题 —— 二等奖</span>
        <span class="cv-date">2021.10</span>
      </div>
    </div>
    <div class="cv-entry">
      <div class="cv-entry-header">
        <span>美国大学生数学建模竞赛 —— Honorable Mention奖</span>
        <span class="cv-date">2017.01</span>
      </div>
    </div>
  </section>

  <section class="cv-section">
    <h2>{t(lang, 'cv.skills')}</h2>
    <div class="skills-grid">
      <div>
        <span class="skills-label">编程语言</span>
        C++、Python、MATLAB
      </div>
      <div>
        <span class="skills-label">EDA领域</span>
        静态时序分析、串扰计算、功耗分析、毛刺功耗优化
      </div>
      <div>
        <span class="skills-label">数学基础</span>
        数值线性代数、优化、ODE/PDE求解、数学建模
      </div>
    </div>
  </section>
</SidebarLayout>

<style>
.cv-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 2.5rem;
  flex-wrap: wrap;
  gap: 1rem;
}
h1 { font-size: 2rem; }

.cv-section { margin-bottom: 2.5rem; }
.cv-section h2 {
  font-size: 0.85rem;
  letter-spacing: 0.15em;
  color: var(--accent-1);
  font-family: var(--font-sans);
  font-weight: 600;
  margin-bottom: 1.25rem;
  padding-bottom: 0.5rem;
  border-bottom: 1px solid var(--border);
}

.cv-entry {
  margin-bottom: 1.25rem;
  padding-left: 1rem;
  border-left: 2px solid var(--border);
}
.cv-entry-header {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0.5rem;
  margin-bottom: 0.2rem;
}
.cv-date {
  font-size: 0.8rem;
  color: var(--text-muted);
  font-family: var(--font-mono);
}
.cv-entry-sub {
  font-size: 0.875rem;
  color: var(--text-muted);
  margin-bottom: 0.4rem;
}
.cv-entry p { font-size: 0.9rem; color: var(--text-muted); }
.cv-list {
  font-size: 0.9rem;
  color: var(--text-muted);
  padding-left: 1.2rem;
  margin: 0;
}
.cv-list li { margin-bottom: 0.3rem; }

.skills-grid { display: flex; flex-direction: column; gap: 0.6rem; font-size: 0.9rem; }
.skills-label {
  font-family: var(--font-mono);
  color: var(--accent-1);
  font-size: 0.8rem;
  margin-right: 0.75rem;
}
</style>
