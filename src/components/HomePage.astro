---
import SidebarLayout from '../layouts/SidebarLayout.astro';
import ProjectCard from './ProjectCard.astro';
import PublicationCard from './PublicationCard.astro';
import PostCard from './PostCard.astro';
import { getCollection } from 'astro:content';
import { t, localizedPath, type Lang } from '../i18n/ui';

interface Props { lang: Lang }
const { lang } = Astro.props;
const name = t(lang, 'home.name');
const [projects, papers, posts] = await Promise.all([
  getCollection('projects', ({ data }) => data.featured),
  getCollection('publications'),
  getCollection('blog', ({ data }) => !data.draft),
]);
const featuredProjects = projects.slice(0, 3);
const publications = papers.sort((a, b) => b.data.year - a.data.year).slice(0, 2);
const recentPosts = posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
---

<SidebarLayout title={t(lang, 'home.title')} description={name} lang={lang} home>
  <div class="homepage">
    <section class="hero" aria-labelledby="home-heading">
      <div class="hero-content">
        <div class="hero-text">
          <p class="eyebrow hero-intro">{t(lang, 'home.welcome')}</p>
          <h1 id="home-heading" class="hero-intro">{name}</h1>
          <p class="role hero-intro">{t(lang, 'home.role')}</p>
          {t(lang, 'home.bio') && <p class="bio hero-intro">{t(lang, 'home.bio')}</p>}
          <div class="actions hero-intro">
            <a class="pill primary" href={localizedPath('/projects', lang)}>{t(lang, 'home.viewProjects')}</a>
            <a class="pill secondary" href={localizedPath('/cv', lang)}>{t(lang, 'home.viewCV')}</a>
          </div>
        </div>
        <figure class="portrait hero-intro">
          <img src="/profile.jpg" alt={name} fetchpriority="high" />
        </figure>
      </div>
      <a class="explore" href="#selected-work">{t(lang, 'home.explore')} <span aria-hidden="true">↓</span></a>
    </section>

    <section class="home-section projects" id="selected-work" aria-labelledby="projects-heading">
      <div class="section-inner">
        <header class="section-header" data-reveal>
          <div><p class="eyebrow">{t(lang, 'nav.projects')}</p><h2 id="projects-heading">{t(lang, 'home.featuredProjects')}</h2></div>
          <a class="section-link" href={localizedPath('/projects', lang)}>{t(lang, 'home.allProjects')}</a>
        </header>
        {featuredProjects.length > 0 ? (
          <div class="project-grid">
            {featuredProjects.map(p => (
              <div class="card-wrap" data-reveal>
                <ProjectCard title={p.data.title} description={p.data.description} tags={p.data.tags} repo={p.data.repo} demo={p.data.demo} slug={p.slug} lang={lang} />
              </div>
            ))}
          </div>
        ) : <p class="empty" data-reveal>{t(lang, 'home.noProjects')}</p>}
      </div>
    </section>

    {publications.length > 0 && (
      <section class="home-section research" aria-labelledby="publications-heading">
        <div class="section-inner">
          <header class="section-header" data-reveal>
            <div><p class="eyebrow">{t(lang, 'home.research')}</p><h2 id="publications-heading">{t(lang, 'home.publications')}</h2></div>
            <a class="section-link" href={localizedPath('/publications', lang)}>{t(lang, 'home.allPublications')}</a>
          </header>
          <div class="publication-grid">
            {publications.map(p => (
              <div class="card-wrap" data-reveal>
                <PublicationCard title={p.data.title} authors={p.data.authors} venue={p.data.venue} year={p.data.year} tags={p.data.tags} pdf={p.data.pdf} abstract={p.data.abstract} />
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="home-section writing" aria-labelledby="posts-heading">
      <div class="section-inner">
        <header class="section-header" data-reveal>
          <div><p class="eyebrow">{t(lang, 'nav.blog')}</p><h2 id="posts-heading">{t(lang, 'home.recentPosts')}</h2></div>
          <a class="section-link" href={localizedPath('/blog', lang)}>{t(lang, 'home.allPosts')}</a>
        </header>
        {recentPosts.length > 0 ? (
          <div class="post-grid">
            {recentPosts.map(p => (
              <div class="card-wrap" data-reveal>
                <PostCard title={p.data.title} date={p.data.date} description={p.data.description} tags={p.data.tags} slug={p.slug} lang={lang} />
              </div>
            ))}
          </div>
        ) : <p class="empty" data-reveal>{t(lang, 'home.noPosts')}</p>}
      </div>
    </section>

    <section class="contact" aria-labelledby="contact-heading">
      <div class="section-inner" data-reveal>
        <p class="eyebrow">{t(lang, 'nav.contact')}</p>
        <h2 id="contact-heading">{t(lang, 'home.getInTouch')}</h2>
        <p class="contact-note">{t(lang, 'contact.subtitle')}</p>
        <div class="actions">
          <a class="pill primary" href="mailto:hxshen_fdu@outlook.com">{t(lang, 'home.email')}</a>
          <a class="text-link" href="https://github.com/hxshen97" target="_blank" rel="noopener">GitHub <span aria-hidden="true">↗</span></a>
          <a class="text-link" href={localizedPath('/contact', lang)}>{t(lang, 'home.contactDetails')} <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
  </div>
</SidebarLayout>

<script>
  const root = document.querySelector<HTMLElement>('.homepage');
  if (root && typeof IntersectionObserver !== 'undefined') {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    const active = new Set<Animation>();
    const animate = (element: HTMLElement, delay = 0) => {
      if (reducedMotion.matches || typeof element.animate !== 'function') return;
      const animation = element.animate(
        [{ opacity: 0, transform: 'translateY(20px)' }, { opacity: 1, transform: 'translateY(0)' }],
        { duration: 650, delay, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', fill: 'backwards' },
      );
      active.add(animation);
      animation.finished.then(() => active.delete(animation), () => active.delete(animation));
    };
    root.querySelectorAll<HTMLElement>('.hero-intro').forEach((element, index) => animate(element, index * 70));
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        animate(entry.target as HTMLElement);
        observer.unobserve(entry.target);
      });
    }, { threshold: 0.08 });
    root.querySelectorAll('[data-reveal]').forEach(element => observer.observe(element));
    reducedMotion.addEventListener('change', () => {
      if (reducedMotion.matches) active.forEach(animation => animation.cancel());
    });
    window.addEventListener('pagehide', () => {
      observer.disconnect();
      active.forEach(animation => animation.cancel());
    }, { once: true });
  }
</script>

<style>
  .homepage { --home-gutter: clamp(24px, 4vw, 64px); }
  .hero, .contact { background: #000; color: #fff; }
  .hero { position: relative; padding: clamp(64px, 8vw, 112px) var(--home-gutter) 32px; }
  .hero-content, .section-inner { max-width: 980px; margin: 0 auto; }
  .hero-content { display: grid; grid-template-columns: minmax(0, 1fr) minmax(180px, 28%); align-items: center; gap: clamp(32px, 4vw, 64px); min-height: 360px; }
  .eyebrow { font-size: 14px; font-weight: 600; color: #6e6e73; margin-bottom: 16px; }
  .hero .eyebrow, .contact .eyebrow { color: #a1a1a6; }
  h1 { font-size: clamp(40px, 4.5vw, 56px); line-height: 1.07; color: #fff; letter-spacing: -0.28px; margin-bottom: 24px; }
  .role { font-size: clamp(18px, 2vw, 21px); line-height: 1.47; color: #d2d2d7; max-width: 460px; text-wrap: balance; }
  .bio { margin-top: 20px; color: #d2d2d7; }
  .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px; margin-top: 32px; }
  .pill { display: inline-flex; align-items: center; justify-content: center; min-height: 44px; padding: 10px 22px; border-radius: 980px; font-size: 15px; transition: background 180ms, transform 180ms; }
  .primary { background: #0071e3; color: #fff; }
  .primary:hover { background: #0077ed; color: #fff; text-decoration: none; }
  .secondary { border: 1px solid #2997ff; color: #2997ff; }
  .secondary:hover { background: #151515; text-decoration: none; }
  .pill:active { transform: scale(0.97); }
  .portrait { width: 100%; }
  .portrait img { display: block; width: 100%; height: auto; border-radius: 8px; }
  .explore { display: flex; align-items: center; justify-content: center; gap: 12px; min-height: 44px; width: fit-content; margin: 56px auto 0; color: #a1a1a6; font-size: 14px; }
  .explore span { transition: transform 180ms; }
  .explore:hover { color: #fff; text-decoration: none; }
  .explore:hover span { transform: translateY(3px); }
  .home-section { padding: clamp(56px, 7vw, 88px) var(--home-gutter); scroll-margin-top: 64px; }
  .projects, .writing { background: #f5f5f7; }
  .research { background: #fff; }
  .section-header { display: flex; align-items: end; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 32px; }
  .section-header .eyebrow { margin-bottom: 10px; }
  h2 { font-size: clamp(28px, 3.4vw, 40px); line-height: 1.1; }
  .section-link { display: inline-flex; align-items: center; min-height: 44px; font-size: 14px; }
  .project-grid, .publication-grid, .post-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; }
  .project-grid > :only-child { grid-column: 1 / -1; }
  .card-wrap { min-width: 0; }
  .homepage :global(.card) { height: 100%; padding: clamp(24px, 3vw, 36px); border-radius: 12px; transition: none; box-shadow: none; overflow-wrap: anywhere; }
  .projects :global(.card), .writing :global(.card) { background: #fff; }
  .research :global(.card) { background: #f5f5f7; }
  .homepage :global(.card h3) { font-size: 21px; line-height: 1.25; margin-bottom: 16px; }
  .homepage :global(.desc), .homepage :global(.authors) { color: #6e6e73; font-size: 15px; line-height: 1.5; }
  .homepage :global(.venue) { color: #6e6e73; font-style: normal; }
  .homepage :global(.tag) { background: #f5f5f7; color: #6e6e73; }
  .research :global(.tag) { background: #ebebed; color: #515154; }
  .homepage :global(.links a) { display: inline-flex; align-items: center; min-height: 44px; }
  .empty { color: #6e6e73; font-size: 17px; padding: 16px 0; }
  .contact { padding: clamp(56px, 7vw, 88px) var(--home-gutter); }
  .contact h2 { color: #fff; }
  .contact-note { color: #a1a1a6; margin-top: 20px; font-size: 17px; }
  .text-link { color: #2997ff; display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-size: 15px; }
  @media (max-width: 1000px) { .hero-content { grid-template-columns: minmax(0, 1fr) 180px; gap: 24px; } }
  @media (max-width: 768px) {
    .hero { padding-top: 56px; }
    .hero-content { grid-template-columns: 1fr; gap: 40px; }
    .portrait { width: min(220px, 65%); }
    .hero h1 { font-size: 40px; }
    .explore { margin-top: 32px; }
    .project-grid, .publication-grid, .post-grid { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pill, .explore span { transition: none; }
    .pill:active, .explore:hover span { transform: none; }
  }
</style>
